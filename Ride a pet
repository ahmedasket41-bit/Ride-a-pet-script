local function clearResults()
    for _, child in ipairs(results:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    results.CanvasPosition = Vector2.zero
end

local function findPart(obj)
    if obj:IsA("BasePart") then
        return obj
    end
    if obj:IsA("Model") then
        return obj.PrimaryPart
            or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function selectEgg(obj)
    local part = findPart(obj)
    if not part then
        return
    end

    local old = gui:FindFirstChild("EggHighlight")
    if old then
        old:Destroy()
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "EggHighlight"
    highlight.Adornee = obj
    highlight.FillColor = Color3.fromRGB(0, 255, 90)
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.45
    highlight.Parent = gui

    local character = player.Character
    if character then
        character:PivotTo(
            CFrame.new(part.Position + Vector3.new(0, 5, 0))
        )
    end
end

local function updateSearch()
    clearResults()

    local query = string.lower(search.Text)
    if query == "" then
        return
    end

    local count = 0

    for _, obj in ipairs(workspace:GetDescendants()) do
        if count >= 150 then
            break
        end

        local name = string.lower(obj.Name)
        local isEgg = name:find("egg", 1, true)
            or name:find("بيض", 1, true)

        if isEgg and name:find(query, 1, true) then
            if findPart(obj) then
                count += 1

                local button = Instance.new("TextButton")
                button.Size = UDim2.new(1, -8, 0, 38)
                button.BackgroundColor3 = Color3.fromRGB(50, 100, 65)
                button.TextColor3 = Color3.new(1, 1, 1)
                button.TextSize = 15
                button.Text = "🥚  " .. obj.Name
                button.Parent = results

                button.Activated:Connect(function()
                    selectEgg(obj)
                end)
            end
        end
    end

    results.CanvasSize = UDim2.fromOffset(
        0, layout.AbsoluteContentSize.Y + 10
    )
end

toggle.Activated:Connect(function()
    panel.Visible = not panel.Visible
end)

close.Activated:Connect(function()
    panel.Visible = false
end)

search:GetPropertyChangedSignal("Text"):Connect(updateSearch)

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    results.CanvasSize = UDim2.fromOffset(
        0, layout.AbsoluteContentSize.Y + 10
    )
end)
